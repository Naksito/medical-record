diff --git a/frontend/src/app/services/status.service.ts b/frontend/src/app/services/status.service.ts
new file mode 100644
--- /dev/null	(date 1786894652656)
+++ b/frontend/src/app/services/status.service.ts	(date 1786894652656)
@@ -0,0 +1,24 @@
+import {Injectable} from '@angular/core';
+import {HttpClient} from '@angular/common/http';
+import {environment} from '../../environments/environment';
+import {firstValueFrom} from 'rxjs';
+
+export interface ServiceVersions {
+  api: string;
+  auth: string;
+  users: string;
+  appointments: string;
+}
+
+@Injectable({
+  providedIn: 'root'
+})
+export class StatusService {
+  private readonly statusUrl: string = `${environment.apiGateway}/status`;
+
+  constructor(private httpClient: HttpClient) {}
+
+  public async getVersions(): Promise<ServiceVersions> {
+    return await firstValueFrom(this.httpClient.get<ServiceVersions>(this.statusUrl));
+  }
+}
